--- a/maksa/CMakeLists.txt
+++ b/maksa/CMakeLists.txt
@@ -0,0 +1,32 @@
+# Added by the Maksa integration patch. Requires WITH_UI=Qt.
+add_library(maksa_core STATIC
+  core/exercise_catalog.cc
+  core/routine_planner.cc
+  core/exercise_session.cc
+  core/settings.cc
+  core/exercise_view_adapter.cc
+  core/coordinator.cc)
+target_include_directories(maksa_core PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/core)
+
+add_library(maksa_bridge STATIC
+  integration/workrave_exercise_bridge.cc
+  integration/workrave_config_store.cc
+  integration/MaksaBridge.h
+  integration/MaksaBridge.cc)
+target_include_directories(maksa_bridge PUBLIC
+  ${CMAKE_CURRENT_SOURCE_DIR}/core
+  ${CMAKE_CURRENT_SOURCE_DIR}/integration)
+# Do not add Workrave include paths by hand. Link the owning targets so their
+# PUBLIC usage requirements (include dirs, definitions and link deps) propagate.
+target_link_libraries(maksa_bridge
+  PUBLIC
+    maksa_core
+    workrave-libs-config
+    Qt6::Core
+    Qt6::Qml
+    Qt6::Quick
+  PRIVATE
+    workrave-libs-commonui
+    # workrave-app exports ui/app/include, owner of ui/IApplicationContext.hh.
+    workrave-app)
+set_target_properties(maksa_bridge PROPERTIES AUTOMOC ON)
--- a/maksa/integration/MaksaBridge.cc
+++ b/maksa/integration/MaksaBridge.cc
@@ -0,0 +1,111 @@
+#include "MaksaBridge.h"
+
+// Full definition needed: the constructor calls app->get_configurator().
+#include "ui/IApplicationContext.hh"
+
+#include <QCoreApplication>
+#include <QDir>
+#include <QQuickView>
+#include <QQmlContext>
+#include <QUrl>
+
+#include <memory>
+
+using namespace workledge::core;
+
+MaksaBridge::MaksaBridge(std::shared_ptr<IApplicationContext> app, QObject *parent)
+  : QObject(parent)
+{
+  clock_.start();
+
+  store_ = std::make_unique<workledge::integration::WorkraveConfigStore>(app->get_configurator());
+  std::vector<std::string> warnings;
+  store_->load(settings_, warnings);
+
+  catalog_ = std::make_unique<ExerciseCatalog>();
+  const auto fixture = QDir(QCoreApplication::applicationDirPath()).filePath("maksa/test_exercises.tsv");
+  catalog_->load_tsv(fixture.toStdString());
+
+  plan_ = plan_routine(*catalog_, to_planner_input(settings_, 60));
+  coordinator_ = std::make_unique<BreakExerciseCoordinator>(*catalog_);
+  coordinator_->set_plan(plan_);
+}
+
+void
+MaksaBridge::show()
+{
+  if (view_) return;
+  view_ = std::make_unique<QQuickView>();
+  view_->rootContext()->setContextProperty("maksaBridge", this);
+  view_->setResizeMode(QQuickView::SizeRootObjectToView);
+  view_->resize(340, 120);
+  view_->setSource(QUrl("qrc:/sanctuary/MaksaHud.qml"));
+  view_->show();
+}
+
+void
+MaksaBridge::onBreakEvent(int, int event)
+{
+  // Values from workrave/libs/core/src/gen/RpcBreakTypes.proto:
+  // SHOW_BREAK=1, SHOW_BREAK_FORCED=2 -> start; BREAK_STOP=5,
+  // BREAK_TAKEN=9, BREAK_SKIPPED=8 -> end.
+  const int now = static_cast<int>(clock_.elapsed() / 1000);
+  if (event == 1 || event == 2)
+    {
+      coordinator_->on_break_signal(BreakSignal::ShowBreak, 1, now);
+    }
+  else if (event == 5 || event == 8 || event == 9)
+    {
+      coordinator_->on_break_signal(BreakSignal::BreakTaken, 1, now);
+    }
+  refresh();
+}
+
+QString
+MaksaBridge::title() const
+{
+  const auto *p = coordinator_->presentation();
+  return p == nullptr ? QStringLiteral("TEST FIXTURE — no active session")
+                      : QString::fromStdString(p->title);
+}
+
+QString
+MaksaBridge::step() const
+{
+  const auto *p = coordinator_->presentation();
+  if (p == nullptr) return QStringLiteral("0/0");
+  return QString("%1/%2").arg(p->step_index).arg(p->total_steps);
+}
+
+QString
+MaksaBridge::state() const
+{
+  return QString::fromStdString(to_string(coordinator_->state()));
+}
+
+void
+MaksaBridge::refresh()
+{
+  emit changed();
+}
+
+void
+MaksaBridge::pause()
+{
+  coordinator_->command(ExerciseCommand::Pause, static_cast<int>(clock_.elapsed() / 1000));
+  refresh();
+}
+
+void
+MaksaBridge::resume()
+{
+  coordinator_->command(ExerciseCommand::Resume, static_cast<int>(clock_.elapsed() / 1000));
+  refresh();
+}
+
+void
+MaksaBridge::skip()
+{
+  coordinator_->command(ExerciseCommand::Skip, static_cast<int>(clock_.elapsed() / 1000));
+  refresh();
+}
--- a/maksa/integration/MaksaBridge.h
+++ b/maksa/integration/MaksaBridge.h
@@ -0,0 +1,55 @@
+#pragma once
+
+// UNVERIFIED minimal bridge added by the integration patch.
+// It is compiled only in the patched Workrave Qt build.
+
+#include <QElapsedTimer>
+#include <QObject>
+#include <QString>
+
+#include "coordinator.h"
+#include "exercise_catalog.h"
+#include "routine_planner.h"
+#include "settings.h"
+#include "workrave_config_store.h"
+
+// Global namespace, as in upstream ui/IApplicationContext.hh. Only the
+// shared_ptr signature is needed here; the .cc includes the full interface.
+class IApplicationContext;
+class QQuickView;
+
+class MaksaBridge : public QObject
+{
+  Q_OBJECT
+  Q_PROPERTY(QString title READ title NOTIFY changed)
+  Q_PROPERTY(QString step READ step NOTIFY changed)
+  Q_PROPERTY(QString state READ state NOTIFY changed)
+
+public:
+  MaksaBridge(std::shared_ptr<IApplicationContext> app, QObject *parent = nullptr);
+  void show();
+  void onBreakEvent(int break_id, int event);
+
+  QString title() const;
+  QString step() const;
+  QString state() const;
+
+public slots:
+  void pause();
+  void resume();
+  void skip();
+
+signals:
+  void changed();
+
+private:
+  void refresh();
+
+  std::unique_ptr<workledge::core::ExerciseCatalog> catalog_;
+  workledge::core::Settings settings_;
+  workledge::core::PlanResult plan_;
+  std::unique_ptr<workledge::core::BreakExerciseCoordinator> coordinator_;
+  std::unique_ptr<workledge::integration::WorkraveConfigStore> store_;
+  std::unique_ptr<QQuickView> view_;
+  QElapsedTimer clock_;
+};
--- a/maksa/qml/MaksaHud.qml
+++ b/maksa/qml/MaksaHud.qml
@@ -0,0 +1,53 @@
+// TEST FIXTURE HUD — not release content.
+import QtQuick 2.15
+
+Rectangle {
+    id: root
+    width: 340
+    height: 120
+    radius: 14
+    color: "#20242b"
+    border.color: "#54606d"
+    border.width: 1
+
+    Text {
+        id: titleText
+        anchors { top: parent.top; left: parent.left; margins: 12 }
+        width: parent.width - 24
+        text: maksaBridge != null ? maksaBridge.title : "TEST FIXTURE"
+        color: "#eef2f6"
+        font.pixelSize: 14
+        font.bold: true
+        elide: Text.ElideRight
+    }
+
+    Text {
+        id: stepText
+        anchors { top: titleText.bottom; left: parent.left; leftMargin: 12; topMargin: 6 }
+        text: "step " + (maksaBridge != null ? maksaBridge.step : "0/0")
+              + "  state " + (maksaBridge != null ? maksaBridge.state : "Idle")
+        color: "#9aa6b2"
+        font.pixelSize: 11
+    }
+
+    Row {
+        anchors { bottom: parent.bottom; left: parent.left; margins: 12 }
+        spacing: 6
+        Repeater {
+            model: ["Pause", "Resume", "Skip"]
+            Rectangle {
+                width: 68; height: 26; radius: 7; color: "#35404a"
+                Text { anchors.centerIn: parent; text: modelData; color: "#eef2f6"; font.pixelSize: 11 }
+                MouseArea {
+                    anchors.fill: parent
+                    onClicked: {
+                        if (maksaBridge == null) return;
+                        if (modelData === "Pause") maksaBridge.pause();
+                        else if (modelData === "Resume") maksaBridge.resume();
+                        else maksaBridge.skip();
+                    }
+                }
+            }
+        }
+    }
+}
